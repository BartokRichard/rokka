# Generate this server-side API key under Shipo: Setări → API.
SHIPO_API_KEY=

# Public widget API key from Packeta Client → User support. This is the API
# key, not the API password; the app exposes it to the official Packeta widget.
PACKETA_API_KEY=

# Stripe Sandbox keys. Never expose STRIPE_SECRET_KEY in client-side code.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Airtable Personal Access Token with data.records:read and
# data.records:write access to the orders base. Base/table IDs below match the
# current Rendelések table and can be changed without modifying the code.
AIRTABLE_ACCESS_TOKEN=
AIRTABLE_BASE_ID=app7vwKI5cZe3viAt
AIRTABLE_TABLE_ID=tbla8knQ3XTvedJKp

# Public production origin, for example https://rokka.example.
NEXT_PUBLIC_SITE_URL=

# Temporary 2 RON product for testing real Stripe payments. Disable after testing.
NEXT_PUBLIC_ENABLE_PAYMENT_TEST_PRODUCT=false

# Database-free admin login. Use a long unique password and at least 32 random
# characters for the session secret.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Production persistence: a fine-grained GitHub token with Contents: Read/write
# permission for this repository. Vercel supplies the repository owner/name;
# set GITHUB_REPOSITORY=owner/repo only when those variables are unavailable.
ADMIN_GITHUB_TOKEN=
ADMIN_GITHUB_BRANCH=main
GITHUB_REPOSITORY=
